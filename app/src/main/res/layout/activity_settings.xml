<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_window">
    <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/surface" android:title="@string/settings_title"
        android:titleTextColor="@color/text_primary"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout android:id="@+id/settings_ai_row"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="76dp" android:orientation="horizontal" android:gravity="center_vertical"
                android:padding="16dp" android:clickable="true" android:focusable="true"
                android:background="?android:attr/selectableItemBackground">
                <ImageView android:id="@+id/settings_ai_icon" android:layout_width="24dp"
                    android:layout_height="24dp" android:importantForAccessibility="no"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginLeft="16dp" android:layout_marginRight="12dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/settings_ai_entry" android:textSize="16sp" android:textColor="@color/text_primary"/>
                    <TextView android:id="@+id/settings_ai_summary" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:textSize="13sp" android:textColor="@color/text_secondary"/>
                </LinearLayout>
                <ImageView android:id="@+id/settings_ai_arrow" android:layout_width="18dp"
                    android:layout_height="18dp" android:importantForAccessibility="no"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginLeft="56dp" android:background="@color/divider"/>
            <LinearLayout android:id="@+id/settings_preferences_row"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="76dp" android:orientation="horizontal" android:gravity="center_vertical"
                android:padding="16dp" android:clickable="true" android:focusable="true"
                android:background="?android:attr/selectableItemBackground">
                <ImageView android:id="@+id/settings_preferences_icon" android:layout_width="24dp"
                    android:layout_height="24dp" android:importantForAccessibility="no"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginLeft="16dp" android:layout_marginRight="12dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/settings_preferences_title" android:textSize="16sp" android:textColor="@color/text_primary"/>
                    <TextView android:id="@+id/settings_preferences_summary" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:textSize="13sp" android:textColor="@color/text_secondary"/>
                </LinearLayout>
                <ImageView android:id="@+id/settings_preferences_arrow" android:layout_width="18dp"
                    android:layout_height="18dp" android:importantForAccessibility="no"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginLeft="56dp" android:background="@color/divider"/>
            <LinearLayout android:id="@+id/settings_tools_row"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="76dp" android:orientation="horizontal" android:gravity="center_vertical"
                android:padding="16dp" android:clickable="true" android:focusable="true"
                android:background="?android:attr/selectableItemBackground">
                <ImageView android:id="@+id/settings_tools_icon" android:layout_width="24dp"
                    android:layout_height="24dp" android:importantForAccessibility="no"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginLeft="16dp" android:layout_marginRight="12dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/settings_tools_title" android:textSize="16sp" android:textColor="@color/text_primary"/>
                    <TextView android:id="@+id/settings_tools_summary" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:textSize="13sp" android:textColor="@color/text_secondary"/>
                </LinearLayout>
                <ImageView android:id="@+id/settings_tools_arrow" android:layout_width="18dp"
                    android:layout_height="18dp" android:importantForAccessibility="no"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
