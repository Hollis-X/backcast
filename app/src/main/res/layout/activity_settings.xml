<?xml version="1.0" encoding="utf-8"?>
<!-- 设置首页：M3 分段列表，每行一个 surfaceContainer 圆角块，首尾大圆角、中间小圆角，行间 2dp 缝。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/md_surface">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        app:title="@string/settings_title"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingLeft="16dp" android:paddingRight="16dp"
            android:paddingTop="8dp" android:paddingBottom="24dp">
        <LinearLayout android:id="@+id/settings_ai_row"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:minHeight="72dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="12dp" android:paddingBottom="12dp"
            android:clickable="true" android:focusable="true" android:tag="16dp,4dp">
            <ImageView android:id="@+id/settings_ai_icon" android:layout_width="40dp"
                android:layout_height="40dp" android:scaleType="center" android:importantForAccessibility="no"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginLeft="16dp" android:layout_marginRight="16dp"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/settings_ai_entry" android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="@color/md_on_surface"/>
                <TextView android:id="@+id/settings_ai_summary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="2dp" android:singleLine="true"
                    android:ellipsize="end" android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/md_on_surface_variant"/>
            </LinearLayout>
            <ImageView android:id="@+id/settings_ai_arrow" android:layout_width="24dp"
                android:layout_height="24dp" android:scaleType="center" android:importantForAccessibility="no"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/settings_preferences_row"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:minHeight="72dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="12dp" android:paddingBottom="12dp"
            android:clickable="true" android:focusable="true" android:tag="4dp,4dp">
            <ImageView android:id="@+id/settings_preferences_icon" android:layout_width="40dp"
                android:layout_height="40dp" android:scaleType="center" android:importantForAccessibility="no"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginLeft="16dp" android:layout_marginRight="16dp"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/settings_preferences_title" android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="@color/md_on_surface"/>
                <TextView android:id="@+id/settings_preferences_summary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="2dp" android:singleLine="true"
                    android:ellipsize="end" android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/md_on_surface_variant"/>
            </LinearLayout>
            <ImageView android:id="@+id/settings_preferences_arrow" android:layout_width="24dp"
                android:layout_height="24dp" android:scaleType="center" android:importantForAccessibility="no"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/settings_tools_row"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:minHeight="72dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="12dp" android:paddingBottom="12dp"
            android:clickable="true" android:focusable="true" android:tag="4dp,4dp">
            <ImageView android:id="@+id/settings_tools_icon" android:layout_width="40dp"
                android:layout_height="40dp" android:scaleType="center" android:importantForAccessibility="no"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginLeft="16dp" android:layout_marginRight="16dp"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/settings_tools_title" android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="@color/md_on_surface"/>
                <TextView android:id="@+id/settings_tools_summary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="2dp" android:singleLine="true"
                    android:ellipsize="end" android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/md_on_surface_variant"/>
            </LinearLayout>
            <ImageView android:id="@+id/settings_tools_arrow" android:layout_width="24dp"
                android:layout_height="24dp" android:scaleType="center" android:importantForAccessibility="no"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/settings_mcp_row"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:minHeight="72dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="12dp" android:paddingBottom="12dp"
            android:clickable="true" android:focusable="true" android:tag="4dp,4dp">
            <ImageView android:id="@+id/settings_mcp_icon" android:layout_width="40dp"
                android:layout_height="40dp" android:scaleType="center" android:importantForAccessibility="no"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginLeft="16dp" android:layout_marginRight="16dp"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/settings_mcp_title" android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="@color/md_on_surface"/>
                <TextView android:id="@+id/settings_mcp_summary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="2dp" android:singleLine="true"
                    android:ellipsize="end" android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/md_on_surface_variant"/>
            </LinearLayout>
            <ImageView android:id="@+id/settings_mcp_arrow" android:layout_width="24dp"
                android:layout_height="24dp" android:scaleType="center" android:importantForAccessibility="no"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/settings_background_row"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:minHeight="72dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="12dp" android:paddingBottom="12dp"
            android:clickable="true" android:focusable="true" android:tag="4dp,16dp">
            <ImageView android:id="@+id/settings_background_icon" android:layout_width="40dp"
                android:layout_height="40dp" android:scaleType="center" android:importantForAccessibility="no"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginLeft="16dp" android:layout_marginRight="16dp"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/background_title" android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="@color/md_on_surface"/>
                <TextView android:id="@+id/settings_background_summary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="2dp" android:singleLine="true"
                    android:ellipsize="end" android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/md_on_surface_variant"/>
            </LinearLayout>
            <ImageView android:id="@+id/settings_background_arrow" android:layout_width="24dp"
                android:layout_height="24dp" android:scaleType="center" android:importantForAccessibility="no"/>
        </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
