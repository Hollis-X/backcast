<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/grouped_bg">
    <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/grouped_bg" android:title="@string/settings_title"
        android:titleTextColor="@color/text_primary"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginLeft="16dp" android:layout_marginRight="16dp"
            android:layout_marginTop="8dp" android:layout_marginBottom="24dp"
            android:background="@drawable/bg_settings_group" android:clipToOutline="true">
            <LinearLayout android:id="@+id/settings_ai_row"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="68dp" android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingLeft="16dp" android:paddingRight="14dp" android:paddingTop="12dp" android:paddingBottom="12dp"
                android:clickable="true" android:focusable="true"
                android:background="?android:attr/selectableItemBackground">
                <ImageView android:id="@+id/settings_ai_icon" android:layout_width="34dp"
                    android:layout_height="34dp" android:scaleType="center" android:importantForAccessibility="no"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginLeft="14dp" android:layout_marginRight="10dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/settings_ai_entry" android:textSize="16sp" android:textColor="@color/text_primary"/>
                    <TextView android:id="@+id/settings_ai_summary" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="2dp" android:singleLine="true"
                        android:ellipsize="end" android:textSize="13sp" android:textColor="@color/text_secondary"/>
                </LinearLayout>
                <ImageView android:id="@+id/settings_ai_arrow" android:layout_width="18dp"
                    android:layout_height="18dp" android:importantForAccessibility="no"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginLeft="64dp" android:background="@color/divider"/>
            <LinearLayout android:id="@+id/settings_preferences_row"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="68dp" android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingLeft="16dp" android:paddingRight="14dp" android:paddingTop="12dp" android:paddingBottom="12dp"
                android:clickable="true" android:focusable="true"
                android:background="?android:attr/selectableItemBackground">
                <ImageView android:id="@+id/settings_preferences_icon" android:layout_width="34dp"
                    android:layout_height="34dp" android:scaleType="center" android:importantForAccessibility="no"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginLeft="14dp" android:layout_marginRight="10dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/settings_preferences_title" android:textSize="16sp" android:textColor="@color/text_primary"/>
                    <TextView android:id="@+id/settings_preferences_summary" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="2dp" android:singleLine="true"
                        android:ellipsize="end" android:textSize="13sp" android:textColor="@color/text_secondary"/>
                </LinearLayout>
                <ImageView android:id="@+id/settings_preferences_arrow" android:layout_width="18dp"
                    android:layout_height="18dp" android:importantForAccessibility="no"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginLeft="64dp" android:background="@color/divider"/>
            <LinearLayout android:id="@+id/settings_tools_row"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="68dp" android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingLeft="16dp" android:paddingRight="14dp" android:paddingTop="12dp" android:paddingBottom="12dp"
                android:clickable="true" android:focusable="true"
                android:background="?android:attr/selectableItemBackground">
                <ImageView android:id="@+id/settings_tools_icon" android:layout_width="34dp"
                    android:layout_height="34dp" android:scaleType="center" android:importantForAccessibility="no"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginLeft="14dp" android:layout_marginRight="10dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/settings_tools_title" android:textSize="16sp" android:textColor="@color/text_primary"/>
                    <TextView android:id="@+id/settings_tools_summary" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="2dp" android:singleLine="true"
                        android:ellipsize="end" android:textSize="13sp" android:textColor="@color/text_secondary"/>
                </LinearLayout>
                <ImageView android:id="@+id/settings_tools_arrow" android:layout_width="18dp"
                    android:layout_height="18dp" android:importantForAccessibility="no"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginLeft="64dp" android:background="@color/divider"/>
            <LinearLayout android:id="@+id/settings_mcp_row"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="68dp" android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingLeft="16dp" android:paddingRight="14dp" android:paddingTop="12dp" android:paddingBottom="12dp"
                android:clickable="true" android:focusable="true"
                android:background="?android:attr/selectableItemBackground">
                <ImageView android:id="@+id/settings_mcp_icon" android:layout_width="34dp"
                    android:layout_height="34dp" android:scaleType="center" android:importantForAccessibility="no"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginLeft="14dp" android:layout_marginRight="10dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/settings_mcp_title" android:textSize="16sp" android:textColor="@color/text_primary"/>
                    <TextView android:id="@+id/settings_mcp_summary" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="2dp" android:singleLine="true"
                        android:ellipsize="end" android:textSize="13sp" android:textColor="@color/text_secondary"/>
                </LinearLayout>
                <ImageView android:id="@+id/settings_mcp_arrow" android:layout_width="18dp"
                    android:layout_height="18dp" android:importantForAccessibility="no"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginLeft="64dp" android:background="@color/divider"/>
            <LinearLayout android:id="@+id/settings_background_row"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="68dp" android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingLeft="16dp" android:paddingRight="14dp" android:paddingTop="12dp" android:paddingBottom="12dp"
                android:clickable="true" android:focusable="true"
                android:background="?android:attr/selectableItemBackground">
                <ImageView android:id="@+id/settings_background_icon" android:layout_width="34dp"
                    android:layout_height="34dp" android:scaleType="center" android:importantForAccessibility="no"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginLeft="14dp" android:layout_marginRight="10dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/background_title" android:textSize="16sp" android:textColor="@color/text_primary"/>
                    <TextView android:id="@+id/settings_background_summary" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="2dp" android:singleLine="true"
                        android:ellipsize="end" android:textSize="13sp" android:textColor="@color/text_secondary"/>
                </LinearLayout>
                <ImageView android:id="@+id/settings_background_arrow" android:layout_width="18dp"
                    android:layout_height="18dp" android:importantForAccessibility="no"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
