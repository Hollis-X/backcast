<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_window">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        app:title="@string/settings_preferences_title"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:paddingLeft="16dp" android:paddingRight="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_output_verbosity" style="@style/AppSectionLabel" android:paddingTop="16dp" android:paddingBottom="8dp"/>
            <Spinner android:id="@+id/output_verbosity" android:layout_width="match_parent" android:layout_height="56dp"
                android:spinnerMode="dropdown" android:background="@drawable/bg_spinner" android:popupBackground="@drawable/bg_popup" android:paddingStart="16dp" android:paddingEnd="44dp" android:contentDescription="@string/label_output_verbosity"/>
            <TextView android:id="@+id/output_verbosity_description" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="4dp"
                android:textColor="@color/md_on_surface_variant" android:textAppearance="@style/TextAppearance.Material3.BodySmall"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_reasoning_summary" style="@style/AppSectionLabel" android:paddingTop="16dp" android:paddingBottom="8dp"/>
            <Spinner android:id="@+id/reasoning_summary" android:layout_width="match_parent" android:layout_height="56dp"
                android:spinnerMode="dropdown" android:background="@drawable/bg_spinner" android:popupBackground="@drawable/bg_popup" android:paddingStart="16dp" android:paddingEnd="44dp" android:contentDescription="@string/label_reasoning_summary"/>
            <TextView android:id="@+id/reasoning_summary_description" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="4dp"
                android:textColor="@color/md_on_surface_variant" android:textAppearance="@style/TextAppearance.Material3.BodySmall"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_output_language" style="@style/AppSectionLabel" android:paddingTop="16dp" android:paddingBottom="8dp"/>
            <Spinner android:id="@+id/output_language" android:layout_width="match_parent" android:layout_height="56dp"
                android:spinnerMode="dropdown" android:background="@drawable/bg_spinner" android:popupBackground="@drawable/bg_popup" android:paddingStart="16dp" android:paddingEnd="44dp" android:contentDescription="@string/label_output_language"/>
            <TextView android:id="@+id/output_language_description" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="4dp"
                android:textColor="@color/md_on_surface_variant" android:textAppearance="@style/TextAppearance.Material3.BodySmall"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_agent_concurrency" style="@style/AppSectionLabel" android:paddingTop="16dp" android:paddingBottom="8dp"/>
            <Spinner android:id="@+id/agent_concurrency" android:layout_width="match_parent" android:layout_height="56dp"
                android:spinnerMode="dropdown" android:background="@drawable/bg_spinner" android:popupBackground="@drawable/bg_popup" android:paddingStart="16dp" android:paddingEnd="44dp" android:contentDescription="@string/label_agent_concurrency"/>
            <TextView android:id="@+id/agent_concurrency_description" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="4dp"
                android:textColor="@color/md_on_surface_variant" android:textAppearance="@style/TextAppearance.Material3.BodySmall"/>
            <TextView android:id="@+id/agent_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="8dp" android:textColor="@color/text_secondary" android:textSize="12sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_system_prompt" style="@style/AppSectionLabel" android:paddingTop="16dp" android:paddingBottom="8dp"/>
            <com.google.android.material.textfield.TextInputLayout style="@style/AppField"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:placeholderText="@string/hint_user_prompt">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/system_prompt"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minLines="5" android:gravity="top|start" android:lineSpacingExtra="2dp"
                    android:inputType="textMultiLine|textCapSentences"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/user_prompt_note" android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="4dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_env_context" style="@style/AppSectionLabel" android:paddingTop="16dp" android:paddingBottom="8dp"/>
            <TextView android:id="@+id/env_context" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_group" android:textColor="@color/md_on_surface_variant"
                android:textSize="12sp" android:padding="16dp" android:typeface="monospace" android:layout_marginBottom="16dp"/>
        </LinearLayout>
    </ScrollView>
    <Button android:id="@+id/save" style="@style/AppButton" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginLeft="16dp" android:layout_marginRight="16dp" android:layout_marginTop="8dp" android:layout_marginBottom="16dp"
        android:text="@string/action_save"/>
</LinearLayout>
