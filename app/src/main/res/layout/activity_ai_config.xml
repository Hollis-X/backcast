<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/md_surface">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        app:title="@string/settings_ai_title"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:paddingLeft="16dp" android:paddingRight="16dp" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingTop="8dp" android:paddingBottom="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_ai_provider" style="@style/AppSectionLabel" android:paddingBottom="8dp"/>
            <Spinner android:id="@+id/ai_provider" android:layout_width="match_parent" android:layout_height="56dp"
                android:saveEnabled="false" android:background="@drawable/bg_spinner" android:paddingStart="16dp" android:paddingEnd="44dp"
                android:popupBackground="@drawable/bg_popup"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/ai_provider_help" android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/md_on_surface_variant" android:paddingLeft="16dp" android:paddingRight="16dp"
                android:paddingTop="4dp" android:paddingBottom="16dp"/>
            <com.google.android.material.textfield.TextInputLayout style="@style/AppField"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/label_base_url" app:placeholderText="@string/hint_base_url">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/base_url"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textUri" android:typeface="monospace" android:saveEnabled="false"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/AppField"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:hint="@string/label_api_key" app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/api_key"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textPassword" android:typeface="monospace" android:saveEnabled="false"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/AppField"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:hint="@string/label_model">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/model"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textNoSuggestions" android:typeface="monospace" android:saveEnabled="false"/>
            </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="16dp">
                <Button android:id="@+id/add_saved_model" style="@style/AppButton.Tonal"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginRight="8dp" android:text="@string/action_add_saved_model"/>
                <Button android:id="@+id/fetch_models" style="@style/AppButton.Outlined"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/action_fetch_models"/>
            </LinearLayout>
            <TextView android:id="@+id/fetch_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="8dp" android:paddingLeft="16dp" android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/md_on_surface_variant" android:visibility="gone"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/label_model_pick" style="@style/AppSectionLabel"
                android:paddingTop="20dp" android:paddingBottom="8dp"/>
            <LinearLayout android:id="@+id/model_list" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_settings_group" android:padding="8dp"/>
        </LinearLayout>
    </ScrollView>
    <Button android:id="@+id/save" style="@style/AppButton" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginLeft="16dp" android:layout_marginRight="16dp" android:layout_marginTop="8dp" android:layout_marginBottom="16dp"
        android:text="@string/action_save"/>
</LinearLayout>
