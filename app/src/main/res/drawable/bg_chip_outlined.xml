<?xml version="1.0" encoding="utf-8"?>
<!-- M3 辅助芯片（描边）：32dp 高、8dp 圆角、outlineVariant 细边；按下出现状态层。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#1F44474E">
    <item>
        <shape>
            <solid android:color="@android:color/transparent"/>
            <stroke android:width="1dp" android:color="@color/md_outline_variant"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
</ripple>
