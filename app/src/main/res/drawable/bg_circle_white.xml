<?xml version="1.0" encoding="utf-8"?>
<!-- 白圆。多层淡影模拟模糊，不用 elevation，也不留一条硬边。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:left="1dp" android:right="1dp" android:top="3dp" android:bottom="0dp">
        <shape android:shape="oval">
            <solid android:color="#06000000"/>
        </shape>
    </item>

    <item android:left="0dp" android:right="0dp" android:top="1dp" android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="#0A000000"/>
        </shape>
    </item>

    <item android:left="1dp" android:right="1dp" android:top="0dp" android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF"/>
        </shape>
    </item>

</layer-list>